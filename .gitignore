# Build output (regenerated by `gradle build` / `gradle createFullInstaller`)
build/
bin/
.gradle/

# Node tooling
node-export/node_modules/
node-runner/node_modules/

# Installer staging + large redistributable binaries.
# GitHub rejects files over 100MB outright (mysql-9.7.0-winx64.msi is ~183MB,
# ffmpeg.exe is ~102MB) - these need to be fetched/placed locally instead of
# committed. See installer/README.md for where to get the MySQL MSI.
installer/stage/
installer/redist/*.msi
ffmpeg.exe
yt-dlp.exe

# Live secrets - cookies.txt holds a real yt-dlp/Facebook session cookie at
# runtime, never a placeholder. Never commit it.
cookies.txt

# Android app (android-app/) - local.properties holds a machine-specific SDK
# path and must never be committed; build/.gradle/.idea above already cover
# its build output and IDE state since those patterns match at any depth.
android-app/local.properties
*.apk
*.aab
*.jks
*.keystore

# IDE
.idea/
.vscode/

# OS cruft
Thumbs.db
.DS_Store
