<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Certificates & announcements: one card each, same layout as the Settings cards. -->
<ScrollPane fitToWidth="true" styleClass="root"
            style="-fx-background-color:transparent;-fx-background:transparent;"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.afmvfcc.controllers.CommemorationsController">

<VBox spacing="16" style="-fx-padding:4 0 24 0;">

    <Label text="Choose a certificate or announcement, fill in the details and preview it before saving."
           style="-fx-text-fill:#5A6275;-fx-font-size:12px;" wrapText="true"/>

    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- BAPTISM -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="0" GridPane.columnIndex="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-chip, chip-blue">
                    <FontIcon iconLiteral="fas-water" styleClass="stat-icon"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="BAPTISM" styleClass="section-label"/>
                    <Label text="Certificate of Baptism" styleClass="section-title"/>
                </VBox>
            </HBox>
            <Label text="Issued to a member received into church fellowship through water baptism."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <VBox spacing="4">
                <Label text="DETAILS NEEDED" styleClass="form-label"/>
                <Label text="Recipient name  ·  Date of baptism  ·  Church minister"
                       style="-fx-text-fill:#5A6275;-fx-font-size:12px;" wrapText="true"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Saves as a print-ready PDF" style="-fx-text-fill:#9099AA;-fx-font-size:11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" text="Issue Certificate" graphicTextGap="8" styleClass="btn-primary"
                        onAction="#handleBaptismCert">
                    <graphic><FontIcon iconLiteral="fas-file-pdf" iconSize="12" iconColor="#FFFFFF"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- APPRECIATION -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-chip, chip-amber">
                    <FontIcon iconLiteral="fas-award" styleClass="stat-icon" iconColor="#C07800"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="APPRECIATION" styleClass="section-label"/>
                    <Label text="Certificate of Appreciation" styleClass="section-title"/>
                </VBox>
            </HBox>
            <Label text="Recognises faithful service, dedication and commitment to the work of the ministry."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <VBox spacing="4">
                <Label text="DETAILS NEEDED" styleClass="form-label"/>
                <Label text="Recipient name  ·  Date"
                       style="-fx-text-fill:#5A6275;-fx-font-size:12px;" wrapText="true"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Saves as a print-ready PDF" style="-fx-text-fill:#9099AA;-fx-font-size:11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" text="Issue Certificate" graphicTextGap="8" styleClass="btn-primary"
                        onAction="#handleAppreciationCert">
                    <graphic><FontIcon iconLiteral="fas-file-pdf" iconSize="12" iconColor="#FFFFFF"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- MARRIAGE BLESSING -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="1" GridPane.columnIndex="0">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-chip, chip-red">
                    <FontIcon iconLiteral="fas-heart" styleClass="stat-icon" iconColor="#D94040"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="MARRIAGE" styleClass="section-label"/>
                    <Label text="Marriage Blessing" styleClass="section-title"/>
                </VBox>
            </HBox>
            <Label text="Commemorates a couple's union in love, faith and covenant."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <VBox spacing="4">
                <Label text="DETAILS NEEDED" styleClass="form-label"/>
                <Label text="Bride name  ·  Groom name  ·  Date  ·  Couple photo (optional)"
                       style="-fx-text-fill:#5A6275;-fx-font-size:12px;" wrapText="true"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Saves as a print-ready PDF" style="-fx-text-fill:#9099AA;-fx-font-size:11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" text="Issue Certificate" graphicTextGap="8" styleClass="btn-primary"
                        onAction="#handleBlessingCert">
                    <graphic><FontIcon iconLiteral="fas-file-pdf" iconSize="12" iconColor="#FFFFFF"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- DEATH ANNOUNCEMENT -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-chip, chip-blue-dark">
                    <FontIcon iconLiteral="fas-dove" styleClass="stat-icon" iconColor="#2A6BA8"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="ANNOUNCEMENT" styleClass="section-label"/>
                    <Label text="Death Announcement" styleClass="section-title"/>
                </VBox>
            </HBox>
            <Label text="Notifies the congregation of the passing of a member, with the funeral arrangements for the family."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <VBox spacing="4">
                <Label text="DETAILS NEEDED" styleClass="form-label"/>
                <Label text="Member name  ·  Burial date  ·  Time  ·  Venue"
                       style="-fx-text-fill:#5A6275;-fx-font-size:12px;" wrapText="true"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT">
                <Label text="Saves as a PNG image for WhatsApp" style="-fx-text-fill:#9099AA;-fx-font-size:11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" text="Create Announcement" graphicTextGap="8" styleClass="btn-primary"
                        onAction="#handleDeathAnnouncement">
                    <graphic><FontIcon iconLiteral="fas-bullhorn" iconSize="12" iconColor="#FFFFFF"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </GridPane>
</VBox>
</ScrollPane>
