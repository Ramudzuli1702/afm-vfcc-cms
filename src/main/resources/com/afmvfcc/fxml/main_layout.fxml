<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.afmvfcc.controllers.MainLayoutController"
      styleClass="root" prefWidth="1280" prefHeight="780">

    <!-- ── SIDEBAR ── -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">

        <!-- Logo area -->
        <VBox styleClass="sidebar-logo-area" spacing="6" alignment="CENTER"
              style="-fx-padding:18 16 14 16;">
            <ImageView fitWidth="54" fitHeight="54" preserveRatio="true">
                <image>
                    <Image url="@/com/afmvfcc/images/afm_logo.png"/>
                </image>
            </ImageView>
            <Label text="AFM VFCC" styleClass="sidebar-app-title"/>
            <Label text="MANAGEMENT SYSTEM" styleClass="sidebar-app-sub"/>
        </VBox>

        <!-- Nav links -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent;-fx-background:transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="2" style="-fx-padding:12 10;">

                <Label text="MAIN" styleClass="sidebar-section-label"/>
                <Button fx:id="btnDashboard"  text="⬛  Dashboard"      styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnMembers"    text="⬛  Members"         styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnAttendance" text="⬛  Attendance"      styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>

                <Label text="CHURCH" styleClass="sidebar-section-label"/>
                <Button fx:id="btnBoard"      text="⬛  Church Board"    styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnCalendar"   text="⬛  Calendar"        styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnWelfare"    text="⬛  Welfare"         styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnFinance"    text="⬛  Finance"         styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>

                <Label text="COMMUNICATIONS" styleClass="sidebar-section-label"/>
                <Button fx:id="btnComms"      text="⬛  Communications"  styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnWebsite"    text="⬛  Website"         styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>    
                <Button fx:id="btnBroadcast" text="⬛  Broadcast"        styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>

                <Label text="CEREMONIES" styleClass="sidebar-section-label"/>
                <Button fx:id="btnCommems"    text="⬛  Commemorations"  styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>

                <Label text="SYSTEM" styleClass="sidebar-section-label"/>
                <Button fx:id="btnAdmins"     text="⬛  Admins"          styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnAuditLog"   text="⬛  Audit Log"       styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>
                <Button fx:id="btnSettings"   text="⬛  Settings"        styleClass="nav-btn" maxWidth="Infinity" onAction="#navigate"/>

            </VBox>
        </ScrollPane>

        <!-- User info + logout -->
        <VBox styleClass="sidebar-bottom" spacing="8">
            <Label fx:id="sidebarUserName" styleClass="sidebar-user-name" text="Loading..."/>
            <Label fx:id="sidebarUserRole" styleClass="sidebar-user-role" text=""/>
            <Button text="Logout" styleClass="btn-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </VBox>

    <!-- ── MAIN CONTENT ── -->
    <VBox HBox.hgrow="ALWAYS">

        <!-- Topbar -->
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="8">
            <VBox spacing="1">
                <Label fx:id="topbarTitle" styleClass="topbar-title" text="Dashboard"/>
                <Label fx:id="topbarSub"   styleClass="topbar-sub"   text="Welcome back"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnViewWebsite" text="🌐  View Website" styleClass="btn-secondary"
                    style="-fx-font-size:12px;-fx-padding:8 16;"
                    visible="false" managed="false"
                    onAction="#handleViewWebsite"/>
        </HBox>

        <!-- Page content injected here -->
        <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="content-area"/>

    </VBox>
</HBox>
