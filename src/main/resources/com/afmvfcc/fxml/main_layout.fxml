<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.afmvfcc.controllers.MainLayoutController"
           prefWidth="1280" prefHeight="780">

<HBox styleClass="root" StackPane.alignment="CENTER">

    <!-- ── SIDEBAR ── -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">

        <!-- Logo area -->
        <VBox styleClass="sidebar-logo-area" spacing="6" alignment="CENTER"
              style="-fx-padding:18 16 14 16;">
            <ImageView fitWidth="54" fitHeight="54" preserveRatio="true">
                <image>
                    <Image url="@/com/afmvfcc/images/afm_logo.png"/>
                </image>
            </ImageView>
            <Label text="AFM VFCC" styleClass="sidebar-app-title"/>
            <Label text="MANAGEMENT SYSTEM" styleClass="sidebar-app-sub"/>
        </VBox>

        <!-- Nav links -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent;-fx-background:transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="2" style="-fx-padding:12 10;">

                <Label text="MAIN" styleClass="sidebar-section-label"/>
                <Button minWidth="-Infinity" fx:id="btnDashboard"  text="Dashboard"      styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnMembers"    text="Members"         styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnAttendance" text="Attendance"      styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>

                <Label text="CHURCH" styleClass="sidebar-section-label"/>
                <Button minWidth="-Infinity" fx:id="btnBoard"      text="Church Board"    styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnCalendar"   text="Calendar"        styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnWelfare"    text="Welfare"         styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnFinance"    text="Finance"         styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnInventory"  text="Inventory"       styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>

                <Label text="COMMUNICATIONS" styleClass="sidebar-section-label"/>
                <Button minWidth="-Infinity" fx:id="btnComms"      text="Communications"  styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnWebsite"    text="Website"         styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>    
                <Button minWidth="-Infinity" fx:id="btnBroadcast" text="Broadcast"        styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>

                <Label text="CEREMONIES" styleClass="sidebar-section-label"/>
                <Button minWidth="-Infinity" fx:id="btnCommems"    text="Commemorations"  styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>

                <Label text="SYSTEM" styleClass="sidebar-section-label"/>
                <Button minWidth="-Infinity" fx:id="btnAdmins"     text="Admins &amp; Audit"       styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnSettings"   text="Settings"        styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>
                <Button minWidth="-Infinity" fx:id="btnDocumentation" text="Documentation" styleClass="nav-btn" maxWidth="Infinity" graphicTextGap="10" onAction="#navigate"/>

            </VBox>
        </ScrollPane>

        <!-- User info + logout -->
        <VBox styleClass="sidebar-bottom" spacing="8">
            <Label fx:id="sidebarUserName" styleClass="sidebar-user-name" text="Loading..."/>
            <Label fx:id="sidebarUserRole" styleClass="sidebar-user-role" text=""/>
            <Button minWidth="-Infinity" fx:id="btnLogout" text="Logout" styleClass="btn-logout" maxWidth="Infinity"
                    graphicTextGap="8" onAction="#handleLogout"/>
        </VBox>
    </VBox>

    <!-- ── MAIN CONTENT ── -->
    <VBox HBox.hgrow="ALWAYS">

        <!-- Topbar -->
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="8">
            <VBox spacing="1">
                <Label fx:id="topbarTitle" styleClass="topbar-title" text="Dashboard"/>
                <Label fx:id="topbarSub"   styleClass="topbar-sub"   text="Welcome back"/>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>

            <Button minWidth="-Infinity" fx:id="btnViewWebsite" text="View Website" styleClass="btn-secondary"
                    style="-fx-font-size:12px;-fx-padding:8 16;" graphicTextGap="8"
                    visible="false" managed="false"
                    onAction="#handleViewWebsite"/>
        </HBox>

        <!-- Page content injected here -->
        <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="content-area"/>

    </VBox>
</HBox>

    <!-- ── TOAST LAYER — floats above everything, bottom-right.
         mouseTransparent is the key bit: StackPane stretches this VBox to
         fill the whole window by default, so without it this invisible
         layer would sit on top of the entire UI and swallow every click,
         even while empty. pickOnBounds alone does NOT prevent that. ── -->
    <VBox fx:id="toastContainer" spacing="10" mouseTransparent="true"
          alignment="BOTTOM_RIGHT" StackPane.alignment="BOTTOM_RIGHT"
          style="-fx-padding:0 24 24 0;"/>

</StackPane>
