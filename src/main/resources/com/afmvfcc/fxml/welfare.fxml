<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" fitToHeight="true" styleClass="root"
            style="-fx-background-color:transparent;-fx-background:transparent;"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.afmvfcc.controllers.WelfareController">

<VBox spacing="16" style="-fx-padding:4 0 24 0;">

    <!-- ── STAT CARDS ── -->
    <GridPane hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="0" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-amber">
                <FontIcon iconLiteral="fas-hourglass-half" styleClass="stat-icon" iconColor="#C07800"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="PENDING CASES" styleClass="stat-label"/>
                <Label fx:id="statPending" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="1" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue-dark">
                <FontIcon iconLiteral="fas-hands-helping" styleClass="stat-icon" iconColor="#2A6BA8"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="IN PROGRESS" styleClass="stat-label"/>
                <Label fx:id="statInProgress" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="2" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-green">
                <FontIcon iconLiteral="fas-check-circle" styleClass="stat-icon" iconColor="#2E7D4F"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="COMPLETED" styleClass="stat-label"/>
                <Label fx:id="statCompleted" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="3" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue">
                <FontIcon iconLiteral="fas-user-friends" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="WELFARE AGENTS" styleClass="stat-label"/>
                <Label fx:id="statAgents" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
    </GridPane>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- WELFARE CASES TAB -->
        <Tab text="Cases">
            <VBox spacing="12" style="-fx-padding:16 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="welfareSearchField" styleClass="search-field"
                               promptText="Search cases..."
                               onKeyReleased="#handleSearch" prefWidth="280"/>
                    <ComboBox fx:id="statusFilter" styleClass="form-combo"
                              prefWidth="140" onAction="#handleFilter"/>
                    <Label text="Click View to open a case."
                           style="-fx-text-fill:#5A6275;-fx-font-size:12px;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" text="Print" graphicTextGap="8" styleClass="btn-secondary" onAction="#handleExportPdf">
                        <graphic><FontIcon iconLiteral="fas-print" iconSize="13" iconColor="#1E2130"/></graphic>
                    </Button>
                    <Button minWidth="-Infinity" text="New Case" graphicTextGap="8" styleClass="btn-primary" onAction="#handleAddCase">
                        <graphic><FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#FFFFFF"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="welfareTable" VBox.vgrow="ALWAYS" style="-fx-min-height:400px;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colWMember"  text="MEMBER"      prefWidth="200"/>
                        <TableColumn fx:id="colWReason"  text="REASON"      prefWidth="220"/>
                        <TableColumn fx:id="colWWorker"  text="ASSIGNED TO" prefWidth="180"/>
                        <TableColumn fx:id="colWStatus"  text="STATUS"      prefWidth="110"/>
                        <TableColumn fx:id="colWOpened"  text="OPENED"      prefWidth="120"/>
                        <TableColumn fx:id="colWActions" text="ACTIONS"     prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No welfare cases match this filter."/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- WELFARE AGENTS TAB -->
        <Tab text="Welfare Agents">
            <VBox spacing="12" style="-fx-padding:16 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Members designated to visit and support those in need."
                           style="-fx-text-fill:#5A6275;-fx-font-size:12px;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="agentSearchField" styleClass="search-field"
                               promptText="Search agents..."
                               onKeyReleased="#handleAgentSearch"
                               prefWidth="220"/>
                    <Button minWidth="-Infinity" text="Add Agent" graphicTextGap="8" styleClass="btn-primary"
                            onAction="#handleAddAgent">
                        <graphic><FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#FFFFFF"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="agentsTable" VBox.vgrow="ALWAYS" style="-fx-min-height:400px;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colAgentName"    text="AGENT NAME"   prefWidth="260"/>
                        <TableColumn fx:id="colAgentPhone"   text="PHONE"        prefWidth="160"/>
                        <TableColumn fx:id="colAgentCases"   text="CASES ASSIGNED" prefWidth="150"/>
                        <TableColumn fx:id="colAgentActions" text="ACTIONS"      prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No welfare agents yet. Click &quot;Add Agent&quot; to designate one."/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
</ScrollPane>
