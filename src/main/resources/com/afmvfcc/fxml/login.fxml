<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.afmvfcc.controllers.LoginController"
           style="-fx-background-color:#1B3A6B;"
           prefWidth="1280" prefHeight="800">

    <!-- Full-screen navy background with centred card -->
    <VBox alignment="CENTER" spacing="0"
          maxWidth="400" maxHeight="300"
          style="-fx-background-color:#FFFFFF;
                 -fx-background-radius:16;
                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.35),24,0,0,6);"
          StackPane.alignment="CENTER">

        <padding><Insets top="32" right="44" bottom="32" left="44"/></padding>

        <!-- Church logo -->
        <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
            <image>
                <Image url="@/com/afmvfcc/images/afm_logo.png"/>
            </image>
        </ImageView>

        <VBox.margin><Insets bottom="4"/></VBox.margin>

        <!-- Title -->
        <Label text="AFM VFCC" styleClass="login-title"/>
        <Label text="CHURCH MANAGEMENT SYSTEM" styleClass="login-subtitle"
               style="-fx-padding:3 0 22 0;"/>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
               maxWidth="320" textAlignment="CENTER" visible="false"
               style="-fx-padding:0 0 10 0;"/>

        <!-- Username -->
        <VBox spacing="6" style="-fx-padding:0 0 12 0;" maxWidth="Infinity">
            <Label text="USERNAME" styleClass="login-label"/>
            <TextField fx:id="usernameField" styleClass="login-field"
                       promptText="Enter your username" maxWidth="Infinity"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="6" style="-fx-padding:0 0 22 0;" maxWidth="Infinity">
            <Label text="PASSWORD" styleClass="login-label"/>
            <PasswordField fx:id="passwordField" styleClass="login-field"
                           promptText="Enter your password" maxWidth="Infinity"/>
        </VBox>

        <!-- Login button -->
        <Button fx:id="loginButton" text="SIGN IN" styleClass="btn-login"
                maxWidth="Infinity" onAction="#handleLogin"/>

        <!-- Lock status -->
        <Label fx:id="lockLabel" styleClass="error-label" wrapText="true"
               maxWidth="320" textAlignment="CENTER" visible="false"
               style="-fx-padding:10 0 0 0;"/>

        <!-- Footer -->
        <Label text="AFM Victory Fellowship Christian Centre"
               style="-fx-text-fill:#9099AA;-fx-font-size:10px;-fx-padding:18 0 0 0;"/>

    </VBox>

</StackPane>
