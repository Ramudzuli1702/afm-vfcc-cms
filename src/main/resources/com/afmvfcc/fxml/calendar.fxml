<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.afmvfcc.controllers.CalendarController"
      spacing="0" style="-fx-background-color:#F5F6FA;">

    <!-- ── STAT CARDS ── -->
    <GridPane hgap="14" vgap="14" style="-fx-padding:0 0 16 0;">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="0" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue">
                <FontIcon iconLiteral="fas-calendar-alt" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="EVENTS THIS MONTH" styleClass="stat-label"/>
                <Label fx:id="statMonth" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="1" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-amber">
                <FontIcon iconLiteral="fas-bell" styleClass="stat-icon" iconColor="#C07800"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="NEXT 7 DAYS" styleClass="stat-label"/>
                <Label fx:id="statWeek" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="2" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue-dark">
                <FontIcon iconLiteral="fas-calendar-check" styleClass="stat-icon" iconColor="#2A6BA8"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="ALL UPCOMING" styleClass="stat-label"/>
                <Label fx:id="statUpcoming" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="3" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-green">
                <FontIcon iconLiteral="fas-church" styleClass="stat-icon" iconColor="#2E7D4F"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="SERVICES THIS MONTH" styleClass="stat-label"/>
                <Label fx:id="statServices" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
    </GridPane>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-padding:0 0 16 0;">
        <Button minWidth="-Infinity" text="&lt;" styleClass="btn-secondary" onAction="#handlePrevMonth"
                style="-fx-font-weight:700;-fx-font-size:14px;-fx-padding:8 14;"/>
        <Label fx:id="monthYearLabel"
               style="-fx-font-size:18px;-fx-font-weight:700;-fx-text-fill:#1E2130;-fx-min-width:180px;-fx-alignment:CENTER;"/>
        <Button minWidth="-Infinity" text="&gt;" styleClass="btn-secondary" onAction="#handleNextMonth"
                style="-fx-font-weight:700;-fx-font-size:14px;-fx-padding:8 14;"/>
        <Button minWidth="-Infinity" text="Today" styleClass="btn-secondary" onAction="#handleToday"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label text="CATEGORY" style="-fx-font-size:11px;-fx-font-weight:700;-fx-text-fill:#5A6275;"/>
        <ComboBox fx:id="categoryFilter" styleClass="form-combo" prefWidth="130"/>
        <Button minWidth="-Infinity" text="Print Events" graphicTextGap="8" styleClass="btn-secondary" onAction="#handlePrintEvents">
            <graphic><FontIcon iconLiteral="fas-print" iconSize="13" iconColor="#1E2130"/></graphic>
        </Button>
        <Button minWidth="-Infinity" text="Add Event" graphicTextGap="8" styleClass="btn-primary" onAction="#handleAddEvent">
            <graphic><FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#FFFFFF"/></graphic>
        </Button>
    </HBox>

    <!-- Calendar grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent;-fx-background:transparent;">
        <GridPane fx:id="calendarGrid" hgap="0" vgap="0"
                  style="-fx-background-color:#DDE1EA;-fx-border-color:#DDE1EA;"
                  gridLinesVisible="true">
            <columnConstraints>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
                <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS" minWidth="80"/>
            </columnConstraints>
        </GridPane>
    </ScrollPane>
</VBox>
