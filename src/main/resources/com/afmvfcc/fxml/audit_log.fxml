<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.afmvfcc.controllers.AuditLogController" spacing="16">
    <Label fx:id="accessDeniedLabel" text="⛔  Access denied. Only the super admin can view the audit log."
           style="-fx-text-fill:#e74c3c;-fx-font-size:14px;-fx-padding:40;" visible="false" managed="false"/>
    <VBox fx:id="contentBox" spacing="16">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="auditSearchField" styleClass="search-field" promptText="🔍  Search actions or admin names..." onKeyReleased="#handleSearch"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="🔄  Refresh" styleClass="btn-secondary" onAction="#handleRefresh"/>
        </HBox>
        <TableView fx:id="auditTable" VBox.vgrow="ALWAYS" style="-fx-min-height:540px;">
            <columns>
                <TableColumn fx:id="colAuditAdmin"  text="ADMIN"    prefWidth="180"/>
                <TableColumn fx:id="colAuditAction" text="ACTION"   prefWidth="480"/>
                <TableColumn fx:id="colAuditDate"   text="DATE / TIME" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
