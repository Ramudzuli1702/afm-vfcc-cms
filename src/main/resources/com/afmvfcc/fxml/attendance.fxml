<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.afmvfcc.controllers.AttendanceController"
      spacing="16">

    <!-- ── STAT CARDS ── -->
    <GridPane hgap="14" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="0" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue">
                <FontIcon iconLiteral="fas-clipboard-list" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="TOTAL SESSIONS" styleClass="stat-label"/>
                <Label fx:id="statSessions" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="1" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-amber">
                <FontIcon iconLiteral="fas-door-open" styleClass="stat-icon" iconColor="#C07800"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="OPEN SESSIONS" styleClass="stat-label"/>
                <Label fx:id="statOpenSessions" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="2" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-green">
                <FontIcon iconLiteral="fas-user-check" styleClass="stat-icon" iconColor="#2E7D4F"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="PRESENT LAST SESSION" styleClass="stat-label"/>
                <Label fx:id="statLatestPresent" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
        <HBox styleClass="stat-card, stat-card-compact" GridPane.columnIndex="3" spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-chip, chip-blue-dark">
                <FontIcon iconLiteral="fas-chart-line" styleClass="stat-icon" iconColor="#2A6BA8"/>
            </StackPane>
            <VBox spacing="2">
                <Label text="AVERAGE PER SESSION" styleClass="stat-label"/>
                <Label fx:id="statAvgPresent" text="0" styleClass="stat-number"/>
            </VBox>
        </HBox>
    </GridPane>

    <TabPane fx:id="attendanceTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ── TAKE ATTENDANCE TAB ── -->
        <Tab text="Take Attendance">
            <VBox spacing="12" style="-fx-padding:16;-fx-background-color:#F5F6FA;">

                <!-- ── Row 1: Session selector + ministry filter + IP address ── -->
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color:#FFFFFF;-fx-background-radius:12;
                             -fx-border-color:#DDE1EA;-fx-border-radius:12;
                             -fx-border-width:1;-fx-padding:14 20;">

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="SESSION" styleClass="form-label"/>
                        <ComboBox fx:id="sessionCombo" styleClass="form-combo"
                                  maxWidth="Infinity" promptText="Select or create session"
                                  onAction="#handleSessionSelected"/>
                    </VBox>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="FILTER BY MINISTRY" styleClass="form-label"/>
                        <ComboBox fx:id="attendanceMinistryCombo" styleClass="form-combo"
                                  maxWidth="Infinity" onAction="#handleMinistryFilter"/>
                    </VBox>

                    <VBox spacing="4" prefWidth="140">
                        <Label text="SHOW MEMBERS" styleClass="form-label"/>
                        <ComboBox fx:id="presenceFilterCombo" styleClass="form-combo"
                                  maxWidth="Infinity" onAction="#handlePresenceFilter"/>
                    </VBox>

                    <Separator orientation="VERTICAL" style="-fx-padding:0 8;"/>

                    <!-- IP address + QR for mobile app -->
                    <HBox spacing="10" alignment="CENTER" onMouseClicked="#handleEnlargeQr"
                          style="-fx-cursor:hand;">
                        <ImageView fx:id="attendanceQrThumb" fitWidth="52" fitHeight="52"/>
                        <VBox spacing="3" alignment="CENTER_LEFT">
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-mobile-alt" iconSize="10" iconColor="#9099AA"/>
                                <Label text="APP SERVER IP" styleClass="form-label"/>
                            </HBox>
                            <Label fx:id="ipAddressLabel" text="Detecting..."
                                   style="-fx-font-size:15px;-fx-font-weight:700;
                                          -fx-text-fill:#1B3A6B;-fx-font-family:'Courier New';"/>
                            <Label text="Tap to enlarge QR"
                                   style="-fx-font-size:10px;-fx-text-fill:#9099AA;"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- ── Row 2: Action buttons ── -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color:#FFFFFF;-fx-background-radius:10;
                             -fx-border-color:#DDE1EA;-fx-border-radius:10;
                             -fx-border-width:1;-fx-padding:10 16;">
                    <Button minWidth="-Infinity" text="New Session" graphicTextGap="8" styleClass="btn-primary"
                            onAction="#handleNewSession">
                        <graphic><FontIcon iconLiteral="fas-plus" iconSize="12" iconColor="#FFFFFF"/></graphic>
                    </Button>
                    <Separator orientation="VERTICAL" style="-fx-padding:0 4;"/>
                    <Button minWidth="-Infinity" text="Print All" graphicTextGap="8" styleClass="btn-secondary"
                            onAction="#handleExportExcel">
                        <graphic><FontIcon iconLiteral="fas-print" iconSize="13" iconColor="#1E2130"/></graphic>
                    </Button>
                    <Button minWidth="-Infinity" text="Print Present" graphicTextGap="8" styleClass="btn-secondary"
                            onAction="#handleExportPresentOnly">
                        <graphic><FontIcon iconLiteral="fas-check-circle" iconSize="13" iconColor="#1E2130"/></graphic>
                    </Button>
                    <Separator orientation="VERTICAL" style="-fx-padding:0 4;"/>
                    <Button minWidth="-Infinity" text="Close Session" graphicTextGap="8" styleClass="btn-secondary"
                            style="-fx-text-fill:#D94040;"
                            onAction="#handleCloseSession">
                        <graphic><FontIcon iconLiteral="fas-lock" iconSize="13" iconColor="#D94040"/></graphic>
                    </Button>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" text="Sync with App" graphicTextGap="8" styleClass="btn-secondary"
                            style="-fx-padding:6 12;-fx-font-size:11px;"
                            onAction="#handleSyncWithApp">
                        <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="11" iconColor="#1E2130"/></graphic>
                    </Button>
                </HBox>

                <!-- ── Sync status bar ── -->
                <HBox fx:id="syncBar" spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color:rgba(52,152,219,0.1);
                             -fx-border-color:rgba(52,152,219,0.3);
                             -fx-border-radius:8;-fx-background-radius:8;-fx-padding:8 16;"
                      visible="false" managed="false">
                    <Label fx:id="syncStatusLabel" text="No active session"
                           style="-fx-text-fill:#3498db;-fx-font-size:12px;-fx-font-weight:600;"/>
                </HBox>

                <!-- ── Member search bar ── -->
                <TextField fx:id="attendanceSearchField" styleClass="search-field"
                           promptText="Search member..."
                           onKeyReleased="#handleAttendanceSearch"/>

                <!-- ── Present count + bulk actions ── -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="presentCountLabel" text="Present: 0  /  Total: 0"
                           style="-fx-text-fill:#888;-fx-font-size:12px;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" text="Mark All Present" styleClass="btn-secondary"
                            style="-fx-padding:6 14;-fx-font-size:11px;"
                            onAction="#handleMarkAllPresent"/>
                    <Button minWidth="-Infinity" text="Clear All" styleClass="btn-secondary"
                            style="-fx-padding:6 14;-fx-font-size:11px;"
                            onAction="#handleClearAll"/>
                </HBox>

                <!-- ── Member list ── -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color:transparent;-fx-background:transparent;">
                    <VBox fx:id="attendanceMembersBox" spacing="4"/>
                </ScrollPane>

            </VBox>
        </Tab>

        <!-- ── SESSIONS HISTORY TAB ── -->
        <Tab text="Session History">
            <VBox spacing="12" style="-fx-padding:16;-fx-background-color:#F5F6FA;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="sessionSearchField" styleClass="search-field"
                               promptText="Search sessions..."
                               onKeyReleased="#handleSessionSearch"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <TableView fx:id="sessionsTable" VBox.vgrow="ALWAYS" style="-fx-min-height:400px;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colSessName"     text="SESSION NAME"  prefWidth="195"/>
                        <TableColumn fx:id="colSessDate"     text="DATE"          prefWidth="115"/>
                        <TableColumn fx:id="colSessMinistry" text="MINISTRY"      prefWidth="140"/>
                        <TableColumn fx:id="colSessPresent"  text="PRESENT"       prefWidth="80"/>
                        <TableColumn fx:id="colSessTotal"    text="TOTAL"         prefWidth="70"/>
                        <TableColumn fx:id="colSessStatus"   text="STATUS"        prefWidth="85"/>
                        <TableColumn fx:id="colSessActions"  text="ACTIONS"       prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No attendance sessions yet. Create one with &quot;New Session&quot; on the Take Attendance tab."/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
