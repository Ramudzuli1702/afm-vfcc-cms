<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Two-column card grid: related settings sit side by side (cards in the
     same row stretch to equal height); wide content spans both columns. -->
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.afmvfcc.controllers.SettingsController"
            style="-fx-background-color:transparent;-fx-background:transparent;">

    <GridPane hgap="20" vgap="20" style="-fx-padding:4 0 32 0;">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- ── BACKUP ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="0" GridPane.columnIndex="0">
            <Label text="BACKUP" styleClass="section-label"/>
            <Label text="Database Backup &amp; Restore" styleClass="section-title"/>
            <Label text="Export the full database to a file, or restore from a previous backup."
                style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <VBox spacing="6">
                <Label text="BACKUP LOCATION" styleClass="form-label"/>
                <HBox spacing="8">
                    <TextField fx:id="backupPathField" styleClass="form-field"
                            promptText="e.g. C:\Backups\AFM_VFCC" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button minWidth="-Infinity" text="Browse..." styleClass="btn-secondary" onAction="#handleBrowseBackup"/>
                </HBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button minWidth="-Infinity" text="Backup Now" styleClass="btn-primary" graphicTextGap="8" onAction="#handleBackupNow">
                    <graphic><FontIcon iconLiteral="fas-save" iconSize="13" iconColor="#FFFFFF"/></graphic>
                </Button>
                <Button minWidth="-Infinity" text="Restore Backup…" styleClass="btn-secondary" graphicTextGap="8" onAction="#handleRestoreBackup"
                        style="-fx-border-color:#D94040;-fx-text-fill:#D94040;">
                    <graphic><FontIcon iconLiteral="fas-folder-open" iconSize="13" iconColor="#D94040"/></graphic>
                </Button>
            </HBox>
            <Label fx:id="backupStatusLabel" visible="false" managed="false"
                style="-fx-font-size:12px;-fx-font-weight:600;" wrapText="true"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="11" iconColor="#D94040"/>
                <Label text="Restore will REPLACE all current data with the selected backup file."
                    style="-fx-text-fill:#D94040;-fx-font-size:11px;" wrapText="true"/>
            </HBox>
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Label text="RECENT BACKUPS" styleClass="form-label"/>
                <ListView fx:id="backupHistoryList" prefHeight="110" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:#F5F6FA;-fx-border-color:#DDE1EA;
                                -fx-border-radius:8;-fx-background-radius:8;"/>
            </VBox>
        </VBox>

        <!-- ── DOCUMENT OUTPUT + LOCAL WEBSITE FOLDER (both "where files go") ── -->
        <VBox spacing="20" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <VBox styleClass="page-card" spacing="14" VBox.vgrow="ALWAYS">
                <Label text="DOCUMENTS" styleClass="section-label"/>
                <Label text="Generated Document Storage" styleClass="section-title"/>
                <Label text="Folder for exported reports, member forms and certificates. A subfolder is created for each document type (Members, Welfare, Board, Certificates, etc.) so you are not asked where to save every time."
                    style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
                <VBox spacing="6">
                    <Label text="DOCUMENT OUTPUT FOLDER" styleClass="form-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="documentFolderField" styleClass="form-field"
                                promptText="e.g. C:\Users\You\Documents\AFM VFCC CMS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button minWidth="-Infinity" text="Browse..." styleClass="btn-secondary" onAction="#handleBrowseDocumentFolder"/>
                        <Button minWidth="-Infinity" text="Clear" styleClass="btn-secondary" onAction="#handleClearDocumentFolder"/>
                    </HBox>
                </VBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-lightbulb" iconSize="11" iconColor="#3A86C8"/>
                    <Label text="Leave blank to be asked where to save each document."
                        style="-fx-text-fill:#3A86C8;-fx-font-size:11px;" wrapText="true"/>
                </HBox>
            </VBox>

            <VBox styleClass="page-card" spacing="14" VBox.vgrow="ALWAYS">
                <Label text="WEBSITE" styleClass="section-label"/>
                <Label text="Local Website Folder (optional)" styleClass="section-title"/>
                <Label text="If you also run the website locally, point to your index.html folder and the CMS keeps a local copy of data.js in sync alongside GitHub."
                       style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
                <VBox spacing="6">
                    <Label text="WEBSITE FOLDER (where index.html is)" styleClass="form-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="websiteFolderField" styleClass="form-field"
                                   promptText="e.g. C:\AFM_VFCC_Website" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button minWidth="-Infinity" text="Browse..." styleClass="btn-secondary" onAction="#handleBrowseWebsite"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>

        <!-- ── EMAIL (SMTP) ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="1" GridPane.columnIndex="0">
            <Label text="COMMUNICATIONS" styleClass="section-label"/>
            <Label text="Email Settings (SMTP)" styleClass="section-title"/>
            <Label text="Used for sending bulk email to members. Works with Gmail, Outlook, or any SMTP server."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="SMTP HOST" styleClass="form-label"/>
                    <TextField fx:id="smtpHostField" styleClass="form-field" promptText="smtp.gmail.com" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" prefWidth="100" minWidth="100">
                    <Label text="PORT" styleClass="form-label"/>
                    <TextField fx:id="smtpPortField" styleClass="form-field" promptText="587" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="EMAIL / USERNAME" styleClass="form-label"/>
                    <TextField fx:id="smtpUserField" styleClass="form-field" promptText="your@email.com" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="PASSWORD / APP PASSWORD" styleClass="form-label"/>
                    <PasswordField fx:id="smtpPassField" styleClass="form-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button minWidth="-Infinity" text="Send Test Email" styleClass="btn-secondary" onAction="#handleTestEmail"/>
                <Label fx:id="emailTestLabel" visible="false" wrapText="true" style="-fx-font-size:12px;-fx-font-weight:600;"/>
            </HBox>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-lightbulb" iconSize="11" iconColor="#3A86C8"/>
                <Label text="For Gmail: enable 2-factor auth and use an App Password (not your normal password)."
                       style="-fx-text-fill:#3A86C8;-fx-font-size:11px;" wrapText="true"/>
            </HBox>
        </VBox>

        <!-- ── SMS (BULKSMS) ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <Label text="COMMUNICATIONS" styleClass="section-label"/>
            <Label text="SMS (BulkSMS)" styleClass="section-title"/>
            <Label text="Create a free account at bulksms.com — pay in Rands, no monthly fees."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="TOKEN ID (API KEY)" styleClass="form-label"/>
                    <TextField fx:id="bulkSmsKeyField" styleClass="form-field" promptText="BulkSMS Token ID" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="TOKEN SECRET" styleClass="form-label"/>
                    <PasswordField fx:id="bulkSmsSecretField" styleClass="form-field" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <VBox spacing="6" maxWidth="220">
                <Label text="SENDER ID (optional)" styleClass="form-label"/>
                <TextField fx:id="bulkSmsSenderField" styleClass="form-field" promptText="AFMVFCC" maxWidth="Infinity"/>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button minWidth="-Infinity" text="Send Test SMS" styleClass="btn-secondary" onAction="#handleTestSms"/>
                <Label fx:id="smsTestLabel" visible="false" wrapText="true" style="-fx-font-size:12px;-fx-font-weight:600;"/>
            </HBox>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fas-lightbulb" iconSize="11" iconColor="#3A86C8"/>
                <Label text="In BulkSMS: Settings → API Tokens → Create Token. Copy both the Token ID and Token Secret."
                       style="-fx-text-fill:#3A86C8;-fx-font-size:11px;" wrapText="true"/>
            </HBox>
        </VBox>

        <!-- ── ANNOUNCEMENTS (full width, WhatsApp | Facebook) ── -->
        <VBox styleClass="page-card" spacing="14"
              GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Label text="ANNOUNCEMENTS" styleClass="section-label"/>
            <Label text="WhatsApp &amp; Facebook Credentials" styleClass="section-title"/>
            <Label text="Set up these credentials once to enable posting announcements directly from the CMS."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>
            <HBox spacing="16">
                <!-- WhatsApp -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="0"
                      style="-fx-background-color:#F0FFF4;-fx-border-color:#25D366;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:14 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fab-whatsapp" iconSize="14" iconColor="#128C7E"/>
                        <Label text="WHATSAPP CLOUD API"
                               style="-fx-font-weight:700;-fx-font-size:13px;-fx-text-fill:#128C7E;"/>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="PERMANENT ACCESS TOKEN" styleClass="form-label"/>
                        <TextField fx:id="whatsappTokenField" styleClass="form-field" promptText="EAAxxxxx..." maxWidth="Infinity"/>
                    </VBox>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="PHONE NUMBER ID" styleClass="form-label"/>
                            <TextField fx:id="whatsappPhoneIdField" styleClass="form-field" promptText="123456789012345" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="RECIPIENT (phone / group)" styleClass="form-label"/>
                            <TextField fx:id="whatsappRecipientField" styleClass="form-field" promptText="+27821234567" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Button minWidth="-Infinity" text="Test WhatsApp" styleClass="btn-secondary" onAction="#handleTestWhatsApp"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-lightbulb" iconSize="11" iconColor="#128C7E"/>
                        <Label text="developers.facebook.com → Your App → WhatsApp → API Setup"
                               style="-fx-text-fill:#128C7E;-fx-font-size:11px;" wrapText="true"/>
                    </HBox>
                </VBox>
                <!-- Facebook -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="0"
                      style="-fx-background-color:#EBF5FF;-fx-border-color:#1877F2;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:14 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fab-facebook" iconSize="14" iconColor="#1877F2"/>
                        <Label text="FACEBOOK PAGE API"
                               style="-fx-font-weight:700;-fx-font-size:13px;-fx-text-fill:#1877F2;"/>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="PAGE ACCESS TOKEN (permanent)" styleClass="form-label"/>
                        <TextField fx:id="facebookPageTokenField" styleClass="form-field" promptText="EAAxxxxx..." maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="PAGE ID" styleClass="form-label"/>
                        <TextField fx:id="facebookPageIdField" styleClass="form-field" promptText="123456789" maxWidth="Infinity"/>
                    </VBox>
                    <Button minWidth="-Infinity" text="Test Facebook Post" styleClass="btn-secondary" onAction="#handleTestFacebook"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-lightbulb" iconSize="11" iconColor="#1877F2"/>
                        <Label text="developers.facebook.com → Your App → Graph API Explorer → select your Page token"
                               style="-fx-text-fill:#1877F2;-fx-font-size:11px;" wrapText="true"/>
                    </HBox>
                </VBox>
            </HBox>
            <Label fx:id="annTestStatus" visible="false"
                   style="-fx-font-size:12px;-fx-font-weight:600;" wrapText="true"/>
        </VBox>

        <!-- ── GITHUB INTEGRATION ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="3" GridPane.columnIndex="0">
            <Label text="GITHUB INTEGRATION" styleClass="section-label"/>
            <Label text="Website Auto-Sync (GitHub)" styleClass="section-title"/>
            <Label text="Every event or blog you publish updates data.js in your GitHub repository and uploads/deletes poster images — no manual deployment needed."
                   style="-fx-text-fill:#5A6275;-fx-font-size:13px;" wrapText="true"/>

            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color:#F6F8FF;-fx-border-color:#6E40C9;-fx-border-radius:8;
                         -fx-background-radius:8;-fx-padding:14 16;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-key" iconSize="14" iconColor="#6E40C9"/>
                    <Label text="GITHUB CREDENTIALS"
                           style="-fx-font-weight:700;-fx-font-size:13px;-fx-text-fill:#6E40C9;"/>
                </HBox>
                <VBox spacing="6">
                    <Label text="ACCESS TOKEN (classic, 'repo' scope)" styleClass="form-label"/>
                    <PasswordField fx:id="githubTokenField" styleClass="form-field"
                                   promptText="ghp_xxxxxxxxxxxxxxxxxxxx" maxWidth="Infinity"/>
                </VBox>
                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="REPOSITORY OWNER" styleClass="form-label"/>
                        <TextField fx:id="githubOwnerField" styleClass="form-field"
                                   promptText="Ramudzuli1702" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="REPOSITORY NAME" styleClass="form-label"/>
                        <TextField fx:id="githubRepoField" styleClass="form-field"
                                   promptText="afm_vfcc" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="12">
                    <VBox spacing="6" prefWidth="120" minWidth="120">
                        <Label text="BRANCH" styleClass="form-label"/>
                        <TextField fx:id="githubBranchField" styleClass="form-field"
                                   promptText="main" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="CUSTOM DOMAIN (optional)" styleClass="form-label"/>
                        <TextField fx:id="websiteCustomDomainField" styleClass="form-field"
                                   promptText="www.afmvfcc.co.za" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button minWidth="-Infinity" text="Test Connection" styleClass="btn-secondary" graphicTextGap="8"
                            onAction="#handleTestGitHub">
                        <graphic><FontIcon iconLiteral="fas-link" iconSize="13" iconColor="#1E2130"/></graphic>
                    </Button>
                    <Label fx:id="githubStatusLabel" visible="false" wrapText="true"
                           style="-fx-font-size:12px;-fx-font-weight:600;" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label wrapText="true" style="-fx-text-fill:#6E40C9;-fx-font-size:11px;"
                       text="Create a token: github.com → Settings → Developer settings → Personal access tokens → Tokens (classic) → Generate new token → tick 'repo'. Leave the custom domain blank to use the GitHub Pages URL."/>
            </VBox>
        </VBox>

        <!-- ── BROADCAST ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <Label text="BROADCAST" styleClass="section-label"/>
            <Label text="Facebook → YouTube" styleClass="section-title"/>
            <VBox spacing="6">
                <Label text="VIDEO DOWNLOAD FOLDER" styleClass="form-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="broadcastDownloadFolderField" styleClass="form-field"
                               promptText="e.g. C:\AFM_VFCC_Videos" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button minWidth="-Infinity" text="Browse..." styleClass="btn-secondary" onAction="#handleBrowseBroadcastFolder"/>
                </HBox>
                <Label text="Downloaded videos are deleted automatically after a successful YouTube upload."
                       style="-fx-text-fill:#3A86C8;-fx-font-size:11px;" wrapText="true"/>
            </VBox>
            <VBox spacing="8">
                <Label text="GOOGLE API CREDENTIALS" styleClass="form-label"/>
                <Label fx:id="secretsStatusLabel" text="Checking..."
                       style="-fx-font-size:11px;-fx-text-fill:#9099AA;" wrapText="true"/>
                <Button minWidth="-Infinity" text="Upload client_secrets.json" styleClass="btn-secondary" graphicTextGap="8"
                        onAction="#handleUploadClientSecrets">
                    <graphic><FontIcon iconLiteral="fas-file-upload" iconSize="13" iconColor="#1E2130"/></graphic>
                </Button>
                <Label wrapText="true" style="-fx-text-fill:#3A86C8;-fx-font-size:11px;"
                       text="Google Cloud Console → Your Project → APIs &amp; Services → Credentials → OAuth 2.0 Client ID (Desktop) → Download JSON."/>
            </VBox>
            <VBox spacing="8">
                <Label text="YOUTUBE AUTHORISATION" styleClass="form-label"/>
                <Label fx:id="youtubeAuthStatusLabel" text="Not yet authorised" wrapText="true"
                       style="-fx-font-size:12px;-fx-text-fill:#9099AA;"/>
                <Button minWidth="-Infinity" text="Re-authorise YouTube Account" styleClass="btn-secondary" graphicTextGap="8"
                        onAction="#handleRevokeYoutubeToken">
                    <graphic><FontIcon iconLiteral="fas-key" iconSize="13" iconColor="#1E2130"/></graphic>
                </Button>
                <Label text="Re-authorise if the church changes its Google account or if uploads start failing."
                       style="-fx-text-fill:#3A86C8;-fx-font-size:11px;" wrapText="true"/>
            </VBox>
        </VBox>

        <!-- ── MOBILE APP CONNECTION ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="4" GridPane.columnIndex="0">
            <Label text="MOBILE APP" styleClass="section-label"/>
            <Label text="Connect the Android App" styleClass="section-title"/>
            <Label text="Ushers scan this QR code from the app's Server Settings screen to connect automatically — no typing an IP address."
                   wrapText="true" style="-fx-text-fill:#5A6275;-fx-font-size:13px;"/>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <ImageView fx:id="connectQrImage" fitWidth="150" fitHeight="150"/>
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <VBox spacing="4">
                        <Label text="SERVER ADDRESS" styleClass="form-label"/>
                        <Label fx:id="serverAddressLabel" text="Detecting..." wrapText="true"
                               style="-fx-font-size:16px;-fx-font-weight:700;-fx-text-fill:#1E2130;"/>
                        <Label fx:id="serverAdapterLabel" text="" wrapText="true"
                               style="-fx-font-size:11px;-fx-text-fill:#9099AA;"/>
                    </VBox>
                    <HBox spacing="10">
                        <Button minWidth="-Infinity" text="Copy" styleClass="btn-secondary" graphicTextGap="8" onAction="#handleCopyServerAddress">
                            <graphic><FontIcon iconLiteral="fas-copy" iconSize="13" iconColor="#1E2130"/></graphic>
                        </Button>
                        <Button minWidth="-Infinity" text="Refresh" styleClass="btn-secondary" graphicTextGap="8" onAction="#handleRefreshServerAddress">
                            <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="13" iconColor="#1E2130"/></graphic>
                        </Button>
                    </HBox>
                    <Label fx:id="hotspotNoticeLabel" wrapText="true" style="-fx-text-fill:#C07800;-fx-font-size:11px;"/>
                </VBox>
            </HBox>
            <Label wrapText="true" style="-fx-text-fill:#3A86C8;-fx-font-size:11px;"
                   text="To connect over Mobile Hotspot instead of WiFi: Windows Settings → Network &amp; internet → Mobile hotspot → turn it on, then click Refresh."/>
        </VBox>

        <!-- ── CONNECTED DEVICES ── -->
        <VBox styleClass="page-card" spacing="14" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <Label text="MOBILE APP" styleClass="section-label"/>
            <Label text="Connected Devices &amp; Ushers" styleClass="section-title"/>
            <Label text="Accounts signed in to the Android app. Revoking a device signs it out immediately."
                   wrapText="true" style="-fx-text-fill:#5A6275;-fx-font-size:13px;"/>
            <TableView fx:id="devicesTable" prefHeight="200" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDeviceUser"    text="SIGNED IN AS"  prefWidth="120"/>
                    <TableColumn fx:id="colDeviceRole"    text="ROLE"          prefWidth="60"/>
                    <TableColumn fx:id="colDeviceName"    text="DEVICE"        prefWidth="100"/>
                    <TableColumn fx:id="colDeviceSince"   text="SINCE"         prefWidth="110"/>
                    <TableColumn fx:id="colDeviceActions" text=""              prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="No devices are currently signed in." style="-fx-text-fill:#9099AA;"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ── SAVE ALL ── -->
        <HBox alignment="CENTER_RIGHT" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Button minWidth="-Infinity" text="Save All Settings" styleClass="btn-primary"
                    style="-fx-padding:12 32;" onAction="#handleSaveAll"/>
        </HBox>

    </GridPane>
</ScrollPane>
